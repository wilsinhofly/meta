# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="https://meta.3facil.com"

# DATABASE & CACHE
# Para o container meta-hub dentro da rede Docker:
DATABASE_URL="postgresql://postgres:postgrespassword@postgres:5432/meta_hub?schema=public"
REDIS_URL="redis://redis:6379"

# Se for rodar migrações/scripts diretamente no host EC2:
DATABASE_HOST_URL="postgresql://postgres:postgrespassword@localhost:5433/meta_hub?schema=public"
REDIS_HOST_URL="redis://localhost:6380"

# META PLATFORM CREDENTIALS (Business Manager & System User)
META_APP_ID="960263353494048"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="meta_webhook_secret_verify_token_123"
META_SYSTEM_USER_TOKEN="EAA..."

# CANAIS & ATIVOS DA META
